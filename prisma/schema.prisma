// prisma/schema.prisma（最新ER図対応版）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid()) // UUID化は後で
  // id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  tel      String?
  email    String  @unique
  password String? // Supabase Auth移行対応のためnullable
  photoUrl String? @map("photo_url")

  children Child[]
  posts    Post[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

model Child {
  id           String   @id @default(cuid()) // UUID化は後で
  // id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId     String   @map("parent_id") // @mapのみ
  // parentId     String   @map("parent_id") @db.Uuid
  name         String
  nameKana     String?  @map("name_kana")
  birthday     DateTime @db.Date
  classId      String   @map("class_id") // @mapのみ
  // classId      String   @map("class_id") @db.Uuid
  allergens    String?
  milkAmount   String?  @map("milk_amount")
  milkInterval String?  @map("milk_interval")
  photoUrl     String?  @map("photo_url")

  parent User   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id])
  posts  Post[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // DEFAULTを追加
  deletedAt DateTime? @map("deleted_at")

  // @@index([parentId])
  // @@index([classId])
  @@map("children")
}

model Facility {
  id   String @id @default(cuid()) // UUID化は後で
  // id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String

  classes  Class[]
  managers Manager[]
  staffs   Staff[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // DEFAULTを追加
  deletedAt DateTime? @map("deleted_at")

  @@map("facilities")
}

model Class {
  id         String @id @default(cuid()) // UUID化は後で
  // id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  facilityId String @map("facility_id") @db.Uuid

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  children Child[]
  staffs   Staff[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // DEFAULTを追加
  deletedAt DateTime? @map("deleted_at")

  @@index([facilityId])
  @@map("classes")
}

model Manager {
  id         String @id @default(cuid()) // UUID化は後で
  // id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String @unique
  facilityId String @map("facility_id") @db.Uuid

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // DEFAULTを追加
  deletedAt DateTime? @map("deleted_at")

  @@index([facilityId])
  @@map("managers")
}

model Staff {
  id         String @id @default(cuid()) // UUID化は後で
  // id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String @unique
  facilityId String @map("facility_id") @db.Uuid
  classId    String @map("class_id") @db.Uuid

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  class    Class    @relation(fields: [classId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // DEFAULTを追加
  deletedAt DateTime? @map("deleted_at")

  // @@index([facilityId])
  // @@index([classId])
  @@map("staffs")
}

model Post {
  id                 String   @id @default(cuid()) // UUID化は後で
  // id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId            String   @map("child_id") @db.Uuid
  parentId           String   @map("parent_id") @db.Uuid
  postDay            DateTime @map("post_day") @db.Date
  pickUpPerson       String?  @map("pick_up_person")
  temperature        String?
  messages           String?
  medicationRequired Boolean  @default(false) @map("medication_required")
  typeOfMedication   String?  @map("type_of_medication")
  timingOfMedication String?  @map("timing_of_medication")

  child  Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent User  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  log    Log?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // DEFAULTを追加
  deletedAt DateTime? @map("deleted_at")

  // @@index([childId, postDay])
  // @@index([parentId])
  @@map("posts")
}

model Log {
  id       String  @id @default(cuid()) // UUID化は後で
  // id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId   String  @unique @map("post_id") @db.Uuid
  scenes   String?
  photoUrl String? @map("photo_url")
  staff    String?

  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  events Event[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // DEFAULTを追加
  deletedAt DateTime? @map("deleted_at")

  @@map("logs")
}

model Event {
  id                  String   @id @default(cuid()) // UUID化は後で
  // id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  logId               String   @map("log_id") @db.Uuid
  eventOccurrenceTime DateTime @map("event_occurrence_time")
  title               String
  details             String?

  log Log @relation(fields: [logId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // DEFAULTを追加
  deletedAt DateTime? @map("deleted_at")

  // @@index([logId, eventOccurrenceTime])
  @@map("events")
}
